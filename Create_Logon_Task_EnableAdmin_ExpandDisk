# Create_Logon_Task_EnableAdmin_ExpandDisk.ps1
# Run this script ONCE as Administrator on the golden image.

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$TaskName = 'OneTimeLogonSetup'
$DriveLetter = 'C'
$AdminAccountName = 'wkstncontrol'

function Test-IsAdministrator {
    $currentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($currentIdentity)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

if (-not (Test-IsAdministrator)) {
    throw 'This script must be run from an elevated (Administrator) PowerShell session.'
}

# ── PowerShell code that the scheduled task will execute ─────────────────────
$PsCode = @"
`$ErrorActionPreference = 'Stop'

# 1. Expand the system drive (C:) to the maximum available size
`$driveLetter = '$DriveLetter'

try {
    `$partition = Get-Partition -DriveLetter `$driveLetter
    `$currentSize = `$partition.Size
    `$maxSize = (Get-PartitionSupportedSize -DriveLetter `$driveLetter).SizeMax

    if (`$maxSize -gt `$currentSize) {
        Resize-Partition -DriveLetter `$driveLetter -Size `$maxSize | Out-Null
    }
} catch {
    # Silently ignore if resize is not possible (e.g. no unallocated space)
}

# 2. Enable the built-in local Administrator account
try {
    Enable-LocalUser -Name '$AdminAccountName' -ErrorAction Stop
} catch {
    # Fallback for older builds where LocalAccounts cmdlets might not be available
    net user $AdminAccountName /active:yes | Out-Null
}

# 3. Delete the task so it never runs again
Unregister-ScheduledTask -TaskName '$TaskName' -Confirm:`$false -ErrorAction SilentlyContinue
"@

# Encode the command (required for -EncodedCommand)
$Bytes = [System.Text.Encoding]::Unicode.GetBytes($PsCode)
$EncodedCommand = [Convert]::ToBase64String($Bytes)

# Task Action (hidden window, no profile)
$Action = New-ScheduledTaskAction -Execute 'PowerShell.exe' `
    -Argument "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand $EncodedCommand"

# Trigger: run at next user logon (any interactive user)
$Trigger = New-ScheduledTaskTrigger -AtLogOn

# Run as SYSTEM with highest privileges
$Principal = New-ScheduledTaskPrincipal -UserId 'NT AUTHORITY\SYSTEM' `
    -LogonType ServiceAccount -RunLevel Highest

# Settings
$Settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries `
    -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Minutes 5)

# Replace existing task to keep script idempotent
Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue

# Create and register the task
$Task = New-ScheduledTask -Action $Action -Trigger $Trigger -Principal $Principal -Settings $Settings
Register-ScheduledTask -TaskName $TaskName -InputObject $Task -User 'NT AUTHORITY\SYSTEM' -Force | Out-Null

Write-Host "Scheduled task '$TaskName' has been created successfully." -ForegroundColor Green
Write-Host 'It will:'
Write-Host "   • Expand $DriveLetter`: to maximum size"
Write-Host "   • Enable $AdminAccountName account"
Write-Host '   • Delete itself after running'
Write-Host 'Next time any user logs on, the task will execute automatically.'
